/**
 * Regenerate `generated.ts` from the four markdown prompt files next to this
 * script: `npm run gen:prompts` (Node strips the types natively).
 *
 * Each file is embedded verbatim, trailing newline included, so
 * `PROMPTS.<name>` is byte-identical to the markdown source.
 */
import { readFile, writeFile } from "node:fs/promises";

const NAMES = ["protocol", "supervisor", "lead", "peer"] as const;

type PromptName = (typeof NAMES)[number];

const prompts: Partial<Record<PromptName, string>> = {};
for (const name of NAMES) {
  prompts[name] = await readFile(new URL(`./${name}.md`, import.meta.url), "utf8");
}

const body = JSON.stringify(prompts, null, 2);
const header = [
  "// Generated by `npm run gen:prompts` from protocol.md, supervisor.md, lead.md, peer.md.",
  "// Each prompt is embedded verbatim; edit the markdown and regenerate, never this file.",
].join("\n");

const source = `${header}
export const PROMPTS = ${body} as const;

export type PromptName = keyof typeof PROMPTS;
`;

await writeFile(new URL("./generated.ts", import.meta.url), source, "utf8");
process.stdout.write(`gen:prompts wrote generated.ts (${source.length} bytes) from ${NAMES.length} sources\n`);
